{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(python3 scripts/xt.py *)",
      "Bash(python3 .xtemplates/scripts/xt.py *)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 -m pytest *)",
      "Bash(pytest *)",
      "Bash(scripts/dev-task.sh *)",
      "Bash(.xtemplates/scripts/dev-task.sh *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash*)",
      "Bash(git push *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(date*)",
      "Bash(test *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(tree*)",
      "Bash(find *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod +x *)",
      "Bash(bash -n *)",
      "Bash(python3 *)",
      "Bash(pip list*)",
      "Bash(pip show *)",
      "Bash(pip freeze*)",
      "Bash(uname*)",
      "Bash(whoami)",
      "Bash(id)",
      "Bash(hostname)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(ps *)",
      "Bash(true)",
      "Bash(false)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git remote -v)",
      "Bash(git tag -l*)",
      "Bash(git config --get *)",
      "Bash(git blame *)",
      "Bash(git merge-base *)",
      "Bash(git restore --staged *)",
      "Bash(git cherry-pick *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx --no-install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(ruff *)",
      "Bash(pyright *)",
      "Bash(mypy *)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(gofmt *)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(shellcheck *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(docker push *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -*)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"", "timeout": 20 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-compact.sh\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash-guard.sh\"", "timeout": 600 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit-guard.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__.*(merge_pull_request|auto_merge).*",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-mcp-guard.sh\"", "timeout": 120 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-format.sh\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-guard.sh\"", "timeout": 30 }
        ]
      }
    ]
  }
}
